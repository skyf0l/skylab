// Alloy log collection for the skylab cluster.
// Lint/format locally: `alloy fmt config.alloy` / `alloy validate config.alloy`.
//
// Discover only THIS node's pods (one DaemonSet pod per node -> no duplication).
discovery.kubernetes "pods" {
	role = "pod"

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

// Map pod metadata to Loki labels and build the on-disk log path.
discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_controller_kind"]
		target_label  = "controller_kind"
	}

	// Trivy scan jobs print the whole vulnerability report to stdout as a base64
	// blob (that is how the operator collects it): ~60% of all ingested bytes and
	// useless in Loki. The operator's own logs are still shipped.
	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_controller_kind"]
		separator     = ";"
		regex         = "trivy;Job"
		action        = "drop"
	}

	// /var/log/pods/<namespace>_<pod>_<uid>/<container>/*.log
	rule {
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		action        = "replace"
		replacement   = "/var/log/pods/*$1/*.log"
		target_label  = "__path__"
	}
}

// Expand the path globs into concrete files.
local.file_match "pods" {
	path_targets = discovery.relabel.pod_logs.output
}

// Tail and forward to Loki.
loki.source.file "pods" {
	targets    = local.file_match.pods.targets
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki-gateway.logging.svc.cluster.local/loki/api/v1/push"
	}
}

// ---- OTLP ingest ----
// One push endpoint for everything that speaks OpenTelemetry, in-cluster only:
//   alloy.logging.svc.cluster.local:4317 (gRPC) / :4318 (HTTP)
// Traces go to Tempo, logs to Loki's native OTLP endpoint, metrics to
// Prometheus' remote-write receiver. Scrape-based metrics and the pod-log
// tailing above are untouched — this is a second, additive path for the
// signals only the app itself can produce.
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.processor.memory_limiter.default.input]
		logs    = [otelcol.processor.memory_limiter.default.input]
		traces  = [otelcol.processor.memory_limiter.default.input]
	}
}

// Shed load before the container hits its memory limit: a burst of spans from a
// misbehaving app must not take down log collection with it.
otelcol.processor.memory_limiter "default" {
	check_interval = "1s"
	limit          = "384MiB"

	output {
		metrics = [otelcol.processor.k8sattributes.default.input]
		logs    = [otelcol.processor.k8sattributes.default.input]
		traces  = [otelcol.processor.k8sattributes.default.input]
	}
}

// Stamp the sending pod's identity onto every signal, resolved from the
// connection's source IP. NB: k8s.deployment.name is deliberately absent — it
// needs replicasets RBAC, and setting rbac.rules in values REPLACES the chart's
// whole default rule list rather than appending to it.
otelcol.processor.k8sattributes "default" {
	extract {
		metadata = [
			"k8s.namespace.name",
			"k8s.pod.name",
			"k8s.node.name",
			"k8s.container.name",
		]
	}

	pod_association {
		source {
			from = "connection"
		}
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
		logs    = [otelcol.processor.batch.default.input]
		traces  = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		metrics = [otelcol.exporter.prometheus.default.input]
		logs    = [otelcol.exporter.otlphttp.loki.input]
		traces  = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo.tracing.svc.cluster.local:4317"

		tls {
			insecure = true
		}
	}
}

// Loki 3.x ingests OTLP natively at /otlp (the exporter appends /v1/logs).
// Resource attributes land as structured metadata, which is what makes the
// trace <-> log jump work in Grafana. Apps that send logs here should NOT also
// write them to stdout: the pod-log tailing above would ingest them twice.
otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://loki-gateway.logging.svc.cluster.local/otlp"
	}
}

// OTLP metrics -> Prometheus' remote-write receiver (enabled in the
// kube-prometheus chart). Senders should be configured for cumulative
// temporality (OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative);
// otherwise delta->cumulative accumulation happens here, in memory, and is lost
// on every restart of this pod.
otelcol.exporter.prometheus "default" {
	forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
	endpoint {
		url = "http://kube-prometheus-kube-prome-prometheus.monitoring.svc.cluster.local:9090/api/v1/write"
	}
}
